# =============================================================================
# AI 研发效能智能体 — 环境变量配置
# =============================================================================
# 复制此文件为 .env 并填入实际值：
#   cp .env.example .env
# =============================================================================

# ---- 应用基础配置 ----
APP_NAME=AI研发效能智能体
APP_VERSION=1.0.0
DEBUG=true

# ---- 服务器配置 ----
HOST=0.0.0.0
PORT=8000

# ---- CORS（生产环境改为具体域名，如 "https://your-domain.com"） ----
# 开发环境默认允许 Streamlit 前端端口
ALLOWED_ORIGINS=["http://localhost:8501"]

# ---- API 认证（留空跳过，生产环境务必设置） ----
API_TOKEN=

# ---- LLM 主 Provider ----
# 可选值: dashscope / openai / ollama
LLM_PROVIDER=dashscope

# ---- DashScope（阿里云百炼） ----
DASHSCOPE_API_KEY=
DASHSCOPE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=deepseek-v3
EMBEDDING_MODEL=text-embedding-v3

# ---- OpenAI ----
OPENAI_API_KEY=
OPENAI_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# ---- Ollama（本地部署，无需 API Key） ----
OLLAMA_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# ---- LLM 回退（可选） ----
# 启用后主 Provider 不可用时自动切换到备用 Provider
LLM_FALLBACK_ENABLED=false
LLM_PROVIDERS=["dashscope","ollama"]

# ---- 通用 LLM 参数 ----
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# ---- Agent 执行 ----
AGENT_TIMEOUT_SECONDS=120
AGENT_RECURSION_LIMIT=50

# ---- LLM 重试 ----
LLM_RETRY_MAX_ATTEMPTS=3
LLM_RETRY_BASE_DELAY=1.0
LLM_RETRY_MAX_DELAY=8.0

# ---- LLM 熔断器 ----
LLM_CIRCUIT_BREAKER_THRESHOLD=5
LLM_CIRCUIT_BREAKER_RECOVERY=30.0
LLM_CIRCUIT_BREAKER_SUCCESS=2

# ---- RAG ----
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVER_TOP_K=5
CHROMA_PERSIST_DIR=

# ---- RAG 重排序（召回-重排两阶段） ----
# 开启后召回 RERANK_CANDIDATE_K 个候选 → LLM 重排 → 取前 top_k
# 关闭则退化为单阶段向量检索
RERANK_ENABLED=true
RERANK_CANDIDATE_K=10

# ---- JIRA（可选） ----
# JIRA Cloud 配置示例：
#   JIRA_URL=https://your-site.atlassian.net
#   JIRA_USERNAME=your-email@example.com（登录邮箱）
#   JIRA_API_TOKEN=在 https://id.atlassian.com/manage-profile/security/api-tokens 创建
#   JIRA_PROJECT_KEY=项目 Key（项目页 URL /browse/<KEY>-<编号> 中的 KEY）
# 注：issue type 自动探测（team-managed 项目无 Bug 类型时降级为 任务/Task）
JIRA_URL=
JIRA_USERNAME=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

# ---- Selenium ----
CHROMEDRIVER_PATH=
CHROME_BINARY_PATH=

# ---- 路径（留空自动设为 data/ 下子目录） ----
DATA_DIR=
UPLOAD_DIR=
LOG_DIR=
BACKUP_DIR=

# ---- 日志格式: text（可读） / json（Logstash 兼容，推荐容器环境） ----
LOG_FORMAT=text

# ---- 速率限制 ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=30/minute

# ---- 缓存（RAG 查询结果缓存） ----
CACHE_ENABLED=true
# 后端: memory（默认，无外部依赖） / redis（多进程共享，不可用时自动降级 memory）
CACHE_BACKEND=memory
CACHE_TTL_SECONDS=300
CACHE_MAX_SIZE=1000
# 仅 CACHE_BACKEND=redis 时使用
REDIS_URL=redis://localhost:6379/0

# ---- PII 过滤（日志脱敏：手机号/邮箱/身份证/银行卡） ----
PII_FILTER_ENABLED=true
